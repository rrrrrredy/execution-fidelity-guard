{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrivateHistoricalReplayDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "thread_id",
    "cohort",
    "label_status",
    "task_type",
    "severity",
    "categories",
    "detection",
    "adjudicator",
    "original_harm",
    "expected_intervention",
    "isolation_reexecution_required"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^efg-(failure|success)-[0-9]{3}$"
    },
    "thread_id": {
      "type": "string",
      "minLength": 1
    },
    "cohort": {
      "enum": ["failure", "success"]
    },
    "label_status": {
      "enum": ["provisional", "confirmed"]
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "matched_thread_id": {
      "type": ["string", "null"]
    },
    "severity": {
      "enum": ["none", "minor", "major", "critical"]
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "recent_supplement_promoted",
          "tool_failure_changed_objective",
          "all_scope_narrowed",
          "forbidden_install_prepared",
          "local_task_became_harness",
          "attachment_only_delivery",
          "failed_state_claimed_complete",
          "reversible_exploration_blocked",
          "constraint_forgotten",
          "unauthorized_high_cost_action",
          "result_narrative_mismatch",
          "negative_control"
        ]
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": {
          "enum": [
            "preceding_assistant_before_first_correction",
            "preceding_assistant_before_message",
            "last_assistant_final",
            "explicit_event"
          ]
        },
        "message_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "event_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "adjudicator": {
      "enum": ["user", "external_evidence", "domain_rule"]
    },
    "original_harm": {
      "type": "string"
    },
    "expected_intervention": {
      "enum": ["continue", "remind", "ask", "block", "continue_verification"]
    },
    "isolation_reexecution_required": {
      "type": "boolean"
    }
  }
}
