  },
  "bugs": {
    "url": "https://github.com/rrrrrredy/execution-fidelity-guard/issues"
  },
  "keywords": [
    "codex",
    "plugin",
    "hooks",
    "task-contract",
    "execution-safety"
  ],
  "bin": {
    "efg": "./plugins/execution-fidelity-guard/bin/efg.mjs"
  },
