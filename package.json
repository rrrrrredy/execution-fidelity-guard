    "materialize:manifest": "node scripts/materialize-replay-manifest.mjs",
    "audit:replay": "node scripts/audit-replay-coverage.mjs --check",
    "benchmark:hook": "node scripts/benchmark-hook.mjs",
    "validate": "node scripts/validate-release.mjs",
    "test": "node --test"
  }
}
