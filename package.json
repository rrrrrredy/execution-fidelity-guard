    "LICENSE",
    "NOTICE",
    "PRIVACY.md",
    "SECURITY.md",
    "docs/action-rules.md",
    "docs/architecture.md",
    "docs/integration-contract.md",
    "docs/limitations.md",
    "docs/product-decisions.md",
    "docs/platform/codex-capability-2026-08-28.md",
    "examples",
    "evals/README.md",
    "evals/measurement-protocol.md",
    "evals/replay-case.schema.json",
    "evals/replay-manifest.json",
    "evals/replay-coverage.json",
