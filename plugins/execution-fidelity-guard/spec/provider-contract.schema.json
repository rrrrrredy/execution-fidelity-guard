{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntentProviderContractProjection",
  "description": "Pairs a provider-owned contract envelope with the bounded projection used by this guard.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope",
    "projection"
  ],
  "properties": {
    "envelope": {
      "allOf": [
        {
          "$ref": "./contract-envelope.schema.json"
        },
        {
          "properties": {
            "source": {
              "const": "user-intent-plugin"
            }
          },
          "required": [
            "source",
            "snapshot_sha256"
          ]
        }
      ]
    },
    "projection": {
      "$ref": "./task-contract-lite.schema.json"
    }
  }
}
